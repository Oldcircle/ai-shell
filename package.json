{
  "name": "ai-shell",
  "version": "0.1.0",
  "description": "A Claude Code-like AI coding assistant CLI built from scratch",
  "type": "module",
  "engines": {
    "bun": ">=1.2.0"
  },
  "bin": {
    "ai-shell": "src/cli.tsx"
  },
  "scripts": {
    "dev": "bun run src/cli.tsx",
    "build": "bun build src/cli.tsx --outdir dist --target bun",
    "test": "bun test",
    "lint": "bunx biome lint src/",
    "lint:fix": "bunx biome lint --fix src/",
    "format": "bunx biome format --write src/",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "chalk": "^5.4.1",
    "cli-highlight": "^2.1.11",
    "commander": "^13.1.0",
    "glob": "^11.0.2",
    "ink": "^5.2.0",
    "marked": "^18.0.0",
    "react": "^18.3.1",
    "zod": "^3.24.4",
    "zod-to-json-schema": "^3.24.5",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "@types/react": "^18.3.0",
    "typescript": "^5.8.3"
  }
}
